# ==============================================================================
# Remote Patient Health Monitoring System — Backend Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (inside the backend/ directory):
#    cp .env.example .env
# 2. Adjust settings as required for local development or cloud deployment.
# ==============================================================================

# Application Security
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# Database Connection Options (Dual SQLite / PostgreSQL Engine Supported)
# ------------------------------------------------------------------------------
# Option A: Local Development (Default SQLite File)
DATABASE_URL=sqlite+aiosqlite:///./health_monitor.db

# Option B: Cloud Production (Free Neon.tech or Render PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Device Telemetry Authentication Header
DEVICE_API_KEY_HEADER=X-Device-API-Key

# Allowed CORS Origins (JSON list or comma-separated origins)
# For local development:
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
# For production:
# CORS_ORIGINS=["https://your-frontend-domain.vercel.app","https://remote-health-frontend.onrender.com"]

# Initial Doctor Administrator Account (Created automatically if not present)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Telemetry Bounds & Clinical Thresholds
STALE_READING_THRESHOLD_MINUTES=15
MAX_ECG_SAMPLES_PER_BATCH=10000
APP_VERSION=2.0.0-PROD
