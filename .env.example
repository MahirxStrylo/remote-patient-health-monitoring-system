# ==============================================================================
# Remote Patient Health Monitoring System — Master Environment Configuration Template
# ==============================================================================
# Copy this template to backend/.env and frontend/.env before running.
# ==============================================================================

# --- BACKEND SETTINGS ---
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (Default: local SQLite; Cloud: PostgreSQL via asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./health_monitor.db
# DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Device Ingestion Header
DEVICE_API_KEY_HEADER=X-Device-API-Key

# CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Default System Administrator Bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Clinical Thresholds & Bounds
STALE_READING_THRESHOLD_MINUTES=15
MAX_ECG_SAMPLES_PER_BATCH=10000
APP_VERSION=2.0.0-PROD

# --- FRONTEND SETTINGS ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
